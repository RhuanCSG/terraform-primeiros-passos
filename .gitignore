# =============================================================================
# TERRAFORM
# =============================================================================

# Diretório de providers e plugins baixados pelo terraform init
**/.terraform/*

# Arquivos de estado — NUNCA commitar, contêm dados sensíveis da infra
*.tfstate
*.tfstate.*
*.tfstate.backup

# Arquivos de plano gerados pelo terraform plan
*.tfplan
*.tfplan.*

# Logs de crash
crash.log
crash.*.log

# Arquivos de override (usados localmente para sobrescrever configs)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Arquivos de configuração da CLI do Terraform
.terraformrc
terraform.rc

# =============================================================================
# VARIÁVEIS COM SEGREDOS
# Regra: commitar apenas *.tfvars.example — NUNCA o arquivo real
# =============================================================================
*.tfvars
*.tfvars.json
!*.tfvars.example

# =============================================================================
# CREDENCIAIS E SEGREDOS
# =============================================================================
*.pem
*.key
*.ppk
.env
.env.*
!.env.example
credentials
credentials.json
*secrets*
*secret*
aws-credentials

# =============================================================================
# LOCALSTACK
# =============================================================================
.localstack/
localstack-data/
volume/

# =============================================================================
# SISTEMA OPERACIONAL
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# =============================================================================
# IDEs E EDITORES
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# =============================================================================
# PYTHON (MkDocs)
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
site/
